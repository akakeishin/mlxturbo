<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  mlxturbo-serve を Mac に常駐させる launchd agent の設定例。

  使い方:
    1. このファイルを ~/Library/LaunchAgents/com.mlxturbo.serve.plist にコピーする
       (ファイル名と Label は一致させておくこと)。
    2. 下の REPLACE コメントの直後の値を、自分の環境に合わせて書き換える。
       - REPO_PATH: このリポジトリを clone したパス (uv sync 済みであること)
       - MODEL_PATH: --model に渡すモデルのパスまたは Hugging Face repo ID
       - PORT: 待受ポート
       - LOG_DIR: 標準出力・標準エラーの書き出し先ディレクトリ (存在しなければ先に mkdir -p)
       必要なら --served-model-name / --api-key / --max-queue / --allowed-origins などの
       追加オプションを <array> の中に足す (docs/SERVER.md のオプション一覧を参照)。
    3. 読み込む:
         launchctl load ~/Library/LaunchAgents/com.mlxturbo.serve.plist
       止める:
         launchctl unload ~/Library/LaunchAgents/com.mlxturbo.serve.plist
       ログイン時に自動起動させたくない場合は RunAtLoad を false にする。

  注意:
    - 1 プロセス 1 モデル。別モデルを同時に常駐させたい場合はこのファイルをコピーして
      Label・ProgramArguments・ポートをそれぞれ変え、別の plist として登録する。
    - --host を 0.0.0.0 にして LAN/WAN へ公開する場合は docs/OPERATIONS.md のリバースプロキシ
      節を必ず読むこと。この plist は既定のローカル (127.0.0.1) 待受のままにしてある。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mlxturbo.serve</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string>
    <string>run</string>
    <string>--project</string>
    <!-- REPLACE: このリポジトリの絶対パス -->
    <string>/Users/YOUR_NAME/dev/mlxturbo</string>
    <string>mlxturbo-serve</string>
    <string>--model</string>
    <!-- REPLACE: モデルのパスまたは Hugging Face repo ID -->
    <string>/Users/YOUR_NAME/models/YOUR_MODEL</string>
    <string>--served-model-name</string>
    <string>mymodel</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <!-- REPLACE: 待受ポート -->
    <string>8765</string>
  </array>

  <!-- REPLACE: 実行時の作業ディレクトリ (通常はリポジトリと同じでよい) -->
  <key>WorkingDirectory</key>
  <string>/Users/YOUR_NAME/dev/mlxturbo</string>

  <!-- ログイン時に自動起動する。手動で launchctl start したいだけなら false にする -->
  <key>RunAtLoad</key>
  <true/>

  <!-- プロセスが落ちたら自動再起動する (常駐目的なので既定で有効) -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <!-- REPLACE: ログ出力先。ディレクトリは事前に mkdir -p しておくこと -->
  <key>StandardOutPath</key>
  <string>/Users/YOUR_NAME/Library/Logs/mlxturbo-serve.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_NAME/Library/Logs/mlxturbo-serve.err.log</string>

  <!-- uv/Homebrew が PATH に無い launchd 環境向けに明示しておく -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <!-- モデルロードに数秒〜数十秒かかるため、即クラッシュ判定されないよう猶予を取る -->
  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
